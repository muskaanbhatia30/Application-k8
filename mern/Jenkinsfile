pipeline {
    agent any

    tools {
        nodejs "nodejs"
    }

    environment {
        APP_DIR = 'mern/frontend'
    }

    stages {

        stage('Install  dependency'){
            options { timestamps () }

            // dependency vulnerability will be checked later
            steps{
                dir(env.APP_DIR){
                    sh 'npm install --no-audit'
                }
            }
        }


          stage('Auto Fix (Safe Upgrades)') {
            steps {
                    dir(env.APP_DIR){
                    sh 'npm audit fix || true'
                }
            }
        }
        
        stage('npm Dependency Audit') {
            steps {
                dir(env.APP_DIR) {
                    sh 'npm audit --audit-level=critical'
                }
            }
        }

        
    }
}
